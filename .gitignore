node_modules/
out/
dist/
release/
*.log
.DS_Store
.vite/
spikes/node_modules/

# drizzle-kit writes this while generating a migration. It is a throwaway
# scratch database, never the user's real one — see drizzle.config.ts.
.drizzle-scratch.db

# Per-machine Claude Code permissions. The `.local` suffix is the convention
# for "yours, not the repo's". The skills/ directory beside it is shared and
# is meant to be committed.
.claude/settings.local.json

# No audio in this repo, ever. `source-*.wav` are recordings of a real human
# voice, and the rest are derived from them — see bench/make-fixtures.mjs.
# Supply your own two sources locally; they are yours and they stay local.
# Broadened past bench/: a clip pasted anywhere in the tree is the same
# recording of the same person, and the rule should not depend on where it
# lands.
bench/fixtures/*.wav
*.wav
*.mp3
*.m4a
*.webm

# The API key lives in safeStorage, never in the repo (§2) — but the Phase 0
# scripts read one from a .env, and a real key committed once is a key that
# has to be rotated. Ignore the file rather than trusting the habit.
.env
.env.*
!.env.example

# The user's own dictation history. `dictateflow.db` normally lives in
# userData and never comes near this directory, but a copy dragged here for
# debugging would carry every transcript they have ever spoken.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
recordings/

# Third-party skills installed into the repo by a skills manager, plus its
# lockfile. Vendored someone else's documentation, not this project's — the
# four skills in .claude/skills/ that ARE committed (groq-bench,
# insert-pipeline, phase-0-spikes, widget-constraints) are the project's own.
.agents/
skills-lock.json
.claude/skills/*-with-strix/

# Internal working plan for the open source release. Kept on disk, not
# published — visitors want README and CLAUDE.md, not a personal checklist.
OPEN-SOURCE-PLAN.md

*.tsbuildinfo

# Generated knowledge graph. `graphify update .` rebuilds it from the AST at
# no API cost, and cache/ plus .graphify_root hold absolute paths from the
# machine that built it. 2.3 MB of derived data that would churn on every
# commit — regenerate rather than track.
graphify-out/

# Hook config pointing at a graphify.exe under this machine's home directory.
# The `.local` file beside it is already ignored; this one is only shareable
# once the command is a bare `graphify` on PATH. Ignored until then.
.claude/settings.json

# Personal interview prep, not project documentation. Same reasoning as
# OPEN-SOURCE-PLAN.md above — kept on disk, not published.
docs/INTERVIEW-DRILL.md
docs/CODEBASE-GUIDE.md
docs/moonshine-integration-plan.md

# The safeStorage blob holding the Groq key. It normally lives in userData,
# but migrate-user-data.ts copies one forward from a legacy app root, so the
# filename can legitimately appear next to a checkout. Never commit it.
groq-key.bin

# Code-signing material for Phase 7. A certificate committed once is a
# certificate that has to be revoked.
*.pfx
*.p12
*.pem
*.key
*.cer

# Editor and OS droppings.
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Build and test scratch.
coverage/
.cache/
*.tmp
